CONFIG_IDF_TARGET_ESP32S3=y
CONFIG_ESP_WIFI_FTM_ENABLE=y
CONFIG_ESP_WIFI_FTM_INITIATOR_SUPPORT=y
CONFIG_ESP_WIFI_FTM_RESPONDER_SUPPORT=n
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FTM_MAX_ANCHORS=12
CONFIG_FTM_FRAMES_8=y
CONFIG_FTM_BURST_PERIOD=20
CONFIG_COMMON_CHANNEL=6
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
