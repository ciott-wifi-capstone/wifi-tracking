CONFIG_IDF_TARGET_ESP32S3=y
CONFIG_ESP_WIFI_FTM_ENABLE=y
CONFIG_ESP_WIFI_FTM_INITIATOR_SUPPORT=y
CONFIG_ESP_WIFI_FTM_RESPONDER_SUPPORT=n
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_FREERTOS_HZ=1000
# Keep 8 ID slots so A8 maps to index 7; firmware explicitly disables A7.
CONFIG_FTM_MAX_ANCHORS=8
CONFIG_FTM_FRAMES_8=y
CONFIG_FTM_SESSION_TIMEOUT_MS=1500
CONFIG_FTM_RESCAN_PERIOD_MS=10000
CONFIG_COMMON_CHANNEL=6
# CONFIG_TAG_BW40 is not set
CONFIG_TAG_FLASH_LOG=y
